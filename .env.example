# Apps Script Web App URL (the /exec endpoint).
# Get this from Apps Script: 배포 → 새 배포 → 웹 앱 → URL.
APPS_SCRIPT_URL=https://script.google.com/macros/s/REPLACE_ME/exec

# Token expected by the Apps Script `setApiToken()` script property.
# Used to authenticate write operations (upsert/delete).
APPS_SCRIPT_TOKEN=REPLACE_ME

# ── Supabase (관리자 인증 — admins/sessions 테이블 사용) ────────────────────
# Supabase Project Settings → API.
SUPABASE_URL=https://REPLACE_ME.supabase.co

# service_role 키 — RLS 우회. **절대 클라이언트에 노출 금지**.
# (anon 키와 다른 키이며, 클라이언트가 아닌 서버 코드에서만 사용)
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME
