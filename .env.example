# ── MongoDB Atlas (fashion 데이터 저장소) ──────────────────────────────────
# Atlas 연결 문자열. 비밀번호 포함 — **절대 NEXT_PUBLIC_ 금지**, 클라이언트 노출 금지.
# Atlas → Connect → Drivers 에서 복사 후 USER/PASSWORD/CLUSTER 치환.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority

# DB 이름 (선택, 기본 "fashion"). 컬렉션명은 코드 기본값 "fashion_items".
MONGODB_DB=fashion

# ── Supabase (관리자 인증 — admins/sessions 테이블 사용) ────────────────────
# Supabase Project Settings → API.
SUPABASE_URL=https://REPLACE_ME.supabase.co

# service_role 키 — RLS 우회. **절대 클라이언트에 노출 금지**.
# (anon 키와 다른 키이며, 클라이언트가 아닌 서버 코드에서만 사용)
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME

# ── 사용자 OAuth 2.0 (일반 사용자 로그인 — users/user_sessions 테이블 사용) ──────
# 자체 Authorization Code 플로우. 관리자 인증과 별개이며 Supabase Auth 미사용.
# 각 제공자 콘솔에 등록할 redirect URI:
#   <앱 origin>/api/auth/oauth/google/callback
#   <앱 origin>/api/auth/oauth/kakao/callback
# (로컬: http://localhost:3000/..., Vercel: https://<배포도메인>/...)

# Google Cloud Console → API 및 서비스 → 사용자 인증 정보 → OAuth 2.0 클라이언트 ID.
GOOGLE_CLIENT_ID=REPLACE_ME
GOOGLE_CLIENT_SECRET=REPLACE_ME

# Kakao Developers → 내 애플리케이션 → 앱 키의 "REST API 키" 가 CLIENT_ID.
# CLIENT_SECRET 은 [카카오 로그인 → 보안] 에서 사용함(ON) 으로 설정한 경우에만 입력.
KAKAO_CLIENT_ID=REPLACE_ME
KAKAO_CLIENT_SECRET=

# (선택) 프록시/커스텀 도메인 등으로 요청 origin 과 외부 노출 URL 이 다를 때만 지정.
# 미설정 시 요청 origin 으로 redirect URI 를 자동 계산한다. 예: https://example.com
# OAUTH_REDIRECT_BASE_URL=
